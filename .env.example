# KillSwitch Wallet Environment Configuration
# Copy to .env and fill in values. NEVER commit real API keys or private keys.

# ---------------------------------------------------------------------------
# Chain / RPC — Arbitrum Open House Buildathon default path
# ---------------------------------------------------------------------------
# Local Anvil:
#   RPC_URL=http://127.0.0.1:8545
#   CHAIN_LABEL=anvil
#
# Arbitrum Sepolia (hackathon qualification — preferred):
#   RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
#   # or Alchemy/Infura/Ankr URL
#   ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
#   CHAIN_LABEL=arbitrum-sepolia
#   CONTRACT_DEPLOY_BLOCK=<block when SessionPolicy was deployed>
#
# Ethereum Sepolia (legacy / optional):
#   SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key
#   CHAIN_LABEL=ethereum-sepolia
#
# Optional explorer override (Robinhood Chain or custom):
#   EXPLORER_TX_URL_PREFIX=https://explorer.example/tx

RPC_URL=http://127.0.0.1:8545
# CHAIN_LABEL=anvil

# Optional: public RPC aliases used by forge / deploy scripts
# ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# ARB_ONE_RPC_URL=https://arb1.arbitrum.io/rpc
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key
# ARBISCAN_API_KEY=your_arbiscan_key
# ETHERSCAN_API_KEY=your_etherscan_key

# ---------------------------------------------------------------------------
# Keys: owner grants/freezes/closes; agent proposes payments
# Anvil defaults — local demo ONLY. On Arbitrum Sepolia use funded throwaway keys.
# ---------------------------------------------------------------------------
OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
AGENT_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Backward compat: PRIVATE_KEY is an alias for the AGENT key
PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# SessionPolicy contract address (set by demos/setup.sh or scripts/deploy-arbitrum-sepolia.sh)
CONTRACT_ADDRESS=

# eth_getLogs pagination — set after public-testnet deploy (do not scan from genesis)
# CONTRACT_DEPLOY_BLOCK=
# LOG_CHUNK_BLOCKS=40000

CONSOLE_PORT=8787

# ---------------------------------------------------------------------------
# LLM providers (optional for Arbitrum track — any live LLM or mock is fine)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=kiln|kimi  — missing/placeholder key → mock mode
LLM_PROVIDER=kimi

KILN_API_KEY=your_key_here
KILN_API_BASE_URL=https://api.kilnapi.com/v1
KILN_MODEL=gpt-oss-120b

KIMI_API_KEY=your_kimi_key_here
KIMI_API_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

SESSION_ID=0
USER_INTENT="Buy coffee for 0.05 ETH"

# Fee model (mirrors SessionPolicy.sol): budget max totalCost = amount + 2% fee
# fee = (amount * 2) / 100

# Demo merchants on public nets (defaults: AGENT=coffee, OWNER=API)
# MERCHANT_COFFEE=
# MERCHANT_API=
# MERCHANT_SHADOW=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC

# ---------------------------------------------------------------------------
# Optional P1+: USDG / ERC-20 settlement (not required for qualification)
# ---------------------------------------------------------------------------
# PAYMENT_TOKEN=ETH
# USDC on Arbitrum Sepolia (Circle): 0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
# USDG_TOKEN_ADDRESS=
