# KillSwitch Wallet Environment Configuration
# Copy this file to .env and configure with your values
# NEVER commit real API keys or private keys.

# Blockchain RPC
RPC_URL=http://127.0.0.1:8545

# Optional chain label (else detected from chainId: 31337→anvil, 11155111→sepolia)
# CHAIN_LABEL=anvil

# ---------------------------------------------------------------------------
# Keys: owner grants/freezes/closes; agent proposes payments
# Anvil defaults — local demo ONLY. Never commit real keys.
# ---------------------------------------------------------------------------
# Owner = Anvil account #0
OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Agent = Anvil account #1 (Foundry/Anvil 1.8+ key ends …78690d)
AGENT_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Backward compat: PRIVATE_KEY is an alias for the AGENT key
PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# SessionPolicy contract address (set by demos/setup.sh or demos/demo-up.sh)
CONTRACT_ADDRESS=

# Console
CONSOLE_PORT=8787

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# Furiosa Challenge B official path (default):
#   LLM_PROVIDER=kiln
#   KILN_MODEL=gpt-oss-120b
#   KILN_API_KEY=<from hackathon kit — never commit>
#
# Optional local path — Kimi / Moonshot:
#   LLM_PROVIDER=kimi
#   KIMI_API_KEY=<your key — never commit>
#
# If the selected provider key is missing/placeholder, agent runs in MOCK mode
# (usage labeled mock — not real token counts).
# ---------------------------------------------------------------------------
LLM_PROVIDER=kiln

# Kiln API — Furiosa official path (gpt-oss-120b on NPU)
KILN_API_KEY=your_key_here
KILN_API_BASE_URL=https://api.kilnapi.com/v1
KILN_MODEL=gpt-oss-120b

# Kimi / Moonshot (OpenAI-compatible) — optional local demos
KIMI_API_KEY=your_kimi_key_here
KIMI_API_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# Agent configuration
SESSION_ID=0
USER_INTENT="Buy coffee for 0.05 ETH"

# Fee model (mirrors SessionPolicy.sol): budget is max totalCost = amount + 2% fee
# fee = (amount * 2) / 100

# Optional: Sepolia testnet
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key
# ETHERSCAN_API_KEY=your_etherscan_key
# CHAIN_LABEL=sepolia
