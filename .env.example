# KillSwitch Wallet Environment Configuration
# Copy this file to .env and configure with your values
# NEVER commit real API keys or private keys.

# Blockchain RPC
RPC_URL=http://127.0.0.1:8545

# Private key for agent (Anvil default account 0 — local demo ONLY)
# WARNING: Never commit real private keys!
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# SessionPolicy contract address (set by demos/setup.sh or demos/demo-up.sh)
CONTRACT_ADDRESS=

# Console
CONSOLE_PORT=8787

# ---------------------------------------------------------------------------
# LLM providers (dual path)
# ---------------------------------------------------------------------------
# Furiosa Challenge B official path: Kiln NPU API with model gpt-oss-120b
#   LLM_PROVIDER=kiln
#   KILN_API_KEY=<from hackathon kit — never commit>
#   KILN_MODEL=gpt-oss-120b
#
# Local build / demos may use Kimi (Moonshot) instead:
#   LLM_PROVIDER=kimi
#   KIMI_API_KEY=<your key — never commit>
#
# If the selected provider key is missing/placeholder, agent runs in mock mode.
# ---------------------------------------------------------------------------
LLM_PROVIDER=kimi

# Kimi / Moonshot (OpenAI-compatible) — local demos
KIMI_API_KEY=your_kimi_key_here
KIMI_API_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# Kiln API — Furiosa official path (gpt-oss-120b on NPU)
KILN_API_KEY=your_key_here
KILN_API_BASE_URL=https://api.kilnapi.com/v1
KILN_MODEL=gpt-oss-120b

# Agent configuration
SESSION_ID=0
USER_INTENT="Buy coffee for 0.05 ETH"

# Fee model (mirrors SessionPolicy.sol): budget check uses amount + 2% fee
# fee = (amount * 2) / 100

# Optional: Sepolia testnet
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key
# ETHERSCAN_API_KEY=your_etherscan_key
