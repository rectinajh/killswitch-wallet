# KillSwitch Wallet Environment Configuration
# Copy this file to .env and configure with your values

# Blockchain RPC
RPC_URL=http://127.0.0.1:8545

# Private key for agent (Anvil default account 0)
# WARNING: Never commit real private keys!
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# SessionPolicy contract address (set by setup script)
CONTRACT_ADDRESS=

# Kiln API Configuration
# Get your API key from: https://kilnapi.com/
KILN_API_KEY=your_key_here
KILN_API_BASE_URL=https://api.kilnapi.com/v1

# Agent configuration
SESSION_ID=0
USER_INTENT="Buy coffee for 0.05 ETH"

# Optional: Sepolia testnet
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key
# ETHERSCAN_API_KEY=your_etherscan_key
